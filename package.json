{
  "name": "jass-newspulse-studio",
  "version": "0.6.0",
  "private": true,
  "description": "News research workspace with unified timeline, editable notes, topic collections and JSON backup/restore",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "vite build",
    "start": "electron ."
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^33.2.1",
    "vite": "^6.0.5",
    "wait-on": "^8.0.1"
  }
}